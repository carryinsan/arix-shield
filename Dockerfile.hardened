FROM node:22-alpine
ENV NODE_ENV=production PORT=8080
WORKDIR /opt/arixshield
COPY --chown=65532:65532 package.json ./package.json
COPY --chown=65532:65532 api ./api
COPY --chown=65532:65532 sdk ./sdk
COPY --chown=65532:65532 edge ./edge
COPY --chown=65532:65532 state ./state
USER 65532:65532
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD node edge/healthcheck.mjs
CMD ["node", "edge/gateway.mjs"]
