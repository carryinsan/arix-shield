# Required production runtime
NODE_ENV=production
ARIX_MASTER_SECRET=
CRON_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ARIX_CLEARANCE_KID=
ARIX_CLEARANCE_PRIVATE_JWK=

# Origin lock / reverse proxy
ARIX_ORIGIN_LOCK_REQUIRED=true
ARIX_ORIGIN_PUBLIC_KEY=
ARIX_ORIGIN_REPLAY_TTL_SECONDS=300
EDGE_UPSTREAM_URL=
EDGE_ORIGIN_PRIVATE_KEY_FILE=
EDGE_TRUSTED_PROXY_CIDRS=
EDGE_CLIENT_IP_HEADER=x-forwarded-for
EDGE_MAX_BODY_BYTES=1048576
EDGE_MAX_CONCURRENT_REQUESTS=256
EDGE_MAX_CONNECTIONS=512
EDGE_MAX_BUFFERED_BYTES=33554432
EDGE_REQUEST_TIMEOUT_MS=15000
EDGE_UPSTREAM_TIMEOUT_MS=15000
EDGE_LISTEN_HOST=0.0.0.0
EDGE_TLS_CERT_FILE=
EDGE_TLS_KEY_FILE=
EDGE_ALLOWED_SNI_HOSTS=
EDGE_REQUIRE_CLIENT_CERT=false
EDGE_TLS_CLIENT_CA_FILE=
EDGE_TRUSTED_TLS_TERMINATOR=false
EDGE_UPSTREAM_MTLS_CERT_FILE=
EDGE_UPSTREAM_MTLS_KEY_FILE=
EDGE_UPSTREAM_CA_FILE=
EDGE_SHED_THRESHOLD=0.8
EDGE_SHED_HEADERS_TIMEOUT_MS=2000
EDGE_SHED_KEEPALIVE_TIMEOUT_MS=1000

# Edge middleware clearance (Next.js/Vercel Web API runtime)
ARIX_EDGE_PROOF_REQUIRED=false

# Optional hardened self-hosted runtime. These flags only attest controls;
# deploy the hardened container/seccomp/network policies separately.
ARIX_REQUIRE_HARDENED_RUNTIME=false
ARIX_REQUIRE_HARDENED_HOST=false
ARIX_REQUIRE_POSTGRES_RLS=false
ARIX_POSTGRES_RLS_TABLES=

# Optional self-hosted replicated WAL state service. Upstash remains primary;
# this service is not a drop-in replacement for the Lua-backed Upstash API.
ARIX_STATE_ROLE=primary
ARIX_STATE_DATA_DIR=/var/lib/arixshield-state
ARIX_STATE_PEERS=
ARIX_STATE_NODE_ID=arix-state-node
ARIX_STATE_LISTEN_HOST=127.0.0.1
ARIX_STATE_PORT=8090
ARIX_STATE_TLS_CERT_FILE=
ARIX_STATE_TLS_KEY_FILE=
ARIX_STATE_TRUSTED_TLS_TERMINATOR=false

# Optional process-wide fetch and Node http(s) egress controls. Host/kernel
# firewall rules must be managed independently.
ARIX_PROCESS_EGRESS_FIREWALL=false

# Optional Linux nftables ingress allowlist bootstrapper. Preview is the default;
# supplying --apply-firewall is required before any host policy is changed.
ARIX_BOOTSTRAP_EDGE_PORT=443
ARIX_BOOTSTRAP_SSH_PORT=22
ARIX_BOOTSTRAP_EDGE_CIDRS=
ARIX_BOOTSTRAP_SSH_CIDRS=
