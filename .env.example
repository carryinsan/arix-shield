# Core production secrets. Generate a unique 32+ byte random value.
ARIX_MASTER_SECRET=

# Required for distributed state, serverless rate limiting, sessions, and shared threat data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron authentication. Use a long random value and set the same value in Vercel.
CRON_SECRET=

# Optional encrypted browser-clearance key pair. Generate with: npm run generate:clearance-keys
ARIX_CLEARANCE_KID=
ARIX_CLEARANCE_PRIVATE_JWK=

# Optional commercial threat-intelligence enrichment.
ARIX_ABUSEIPDB_API_KEY=

# Explicit operator-managed provider IP allowlists. Never trust a provider User-Agent alone.
# Example shape: {"github":["192.0.2.0/24"],"stripe":["198.51.100.0/24"],"openai":["203.0.113.0/24"]}
ARIX_TRUSTED_PROVIDER_CIDRS_JSON={}

# Server telemetry ingress limits and retention controls.
ARIX_RECORD_OUTCOME_LIMIT_PER_MINUTE=10000
ARIX_ANALYTICS_QUEUE_RETENTION=50000
ARIX_ANALYTICS_FLUSH_BUDGET=10000

# Configure either ClickHouse OR Tinybird. Do not expose these values to browsers.
ARIX_CLICKHOUSE_URL=
ARIX_CLICKHOUSE_DATABASE=default
ARIX_CLICKHOUSE_USER=default
ARIX_CLICKHOUSE_PASSWORD=
ARIX_CLICKHOUSE_TABLE=arixshield_events
ARIX_TINYBIRD_INGEST_URL=
ARIX_TINYBIRD_QUERY_URL=
ARIX_TINYBIRD_TOKEN=

# Optional GitHub Contents API anchor for Merkle audit roots.
ARIX_AUDIT_GITHUB_TOKEN=
ARIX_AUDIT_GITHUB_OWNER=
ARIX_AUDIT_GITHUB_REPO=
ARIX_AUDIT_GITHUB_PATH=arixshield/audit-roots
ARIX_AUDIT_GITHUB_BRANCH=main

# Configure this same secret on a GitHub webhook targeting /api/github-webhook.
ARIX_GITHUB_WEBHOOK_SECRET=

# Optional hardening switches. Keep disabled unless the application is prepared.
# Enable only if EVERY ID matching (id * 2654435761) % 97 === 0 is permanently reserved.
ARIX_RESERVED_TRAP_ID_SPACE=false
# Optional early threat-feed rejection at /api/shield; verify feed quality first.
ARIX_PREBODY_THREAT_FEED_BLOCK=false
# Optional resource enumeration threshold; default is 12 distinct IDs per actor per 60s.
ARIX_BOLA_DISTINCT_ID_THRESHOLD=12
